{
  "name": "09 Re-engagement day 3 and day 7",
  "nodes": [
    {
      "parameters": {
        "content": "Daily 9am. Day 3 quiet: the pod and the advisor nudge the student. Day 7 quiet: the advisor calls the PARENT as a routine check-in.\nDeliberately a person, not an AI call: parents of a premium program expect one. Smallest.ai stays on sales.",
        "height": 200,
        "width": 420
      },
      "id": "a1bd1f44-23cf-5055-bb9c-5d8aa7912dc3",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -240
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "de926ca8-27b3-5878-aed4-1033ae98d690",
      "name": "Every morning 9:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT st.student_id, st.full_name, st.advisor_id,\n       CASE WHEN last_seen.d = CURRENT_DATE - 3 THEN 3 WHEN last_seen.d = CURRENT_DATE - 7 THEN 7 END AS days_quiet\nFROM alcovia.students st\nCROSS JOIN LATERAL (SELECT MAX((s.started_at AT TIME ZONE 'Asia/Kolkata')::date) AS d FROM alcovia.app_sessions s WHERE s.student_id = st.student_id) last_seen\nWHERE last_seen.d IN (CURRENT_DATE - 3, CURRENT_DATE - 7);",
        "options": {}
      },
      "id": "01e32e33-0a8e-5272-bbc3-f1b83446cbaa",
      "name": "Students gone quiet",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Alcovia Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "de8f653a-8d46-5f5d-81b1-3e1edfc9da39",
              "leftValue": "={{ $json.days_quiet }}",
              "rightValue": 7,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e2613370-df9d-55cf-8a18-2e3fb556851f",
      "name": "Seven days?",
