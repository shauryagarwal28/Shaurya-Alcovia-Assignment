      "id": "1bfef2fc-54db-59b3-ba91-c9b63d0216d6",
      "name": "Workshop seat?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO alcovia.workshop_registrations (workshop_id, campaign_id, seats, amount_inr, paid_at, razorpay_ref)\nVALUES (COALESCE((SELECT workshop_id FROM alcovia.workshop_events WHERE held_on >= CURRENT_DATE ORDER BY held_on LIMIT 1),\n                  (SELECT workshop_id FROM alcovia.workshop_events ORDER BY held_on DESC LIMIT 1)),\n        NULLIF($1, '')::int, $2, $3 / 100.0, now(), $4);",
        "options": {
          "queryReplacement": "={{ $json.body.payload.payment.entity.notes.campaign_id || '' }},{{ $json.body.payload.payment.entity.notes.seats || 1 }},{{ $json.body.payload.payment.entity.amount }},{{ $json.body.payload.payment.entity.id }}"
        }
      },
      "id": "b22565fe-370c-54fa-83af-95d9b036bcd0",
      "name": "Save workshop seats",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        720,
        -80
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Alcovia Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE alcovia.invoices SET paid_on = CURRENT_DATE WHERE razorpay_ref = $1 AND paid_on IS NULL;",
        "options": {
          "queryReplacement": "={{ $json.body.payload.payment.entity.invoice_id }}"
        }
      },
      "id": "16575bbd-8f0b-58bd-ae0c-aa3fdc31b0b6",
